# ---------------------------------------------------------------------------
# Print Cafe AI bot - environment variables
# Copy to .env and fill in actual values. Never commit .env.
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=local              # local | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true              # JSON logs for production, human-readable for local

# --- PostgreSQL ---
POSTGRES_USER=printcafe
POSTGRES_PASSWORD=printcafe
POSTGRES_DB=printcafe
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Async URL is built from the above. Override only if connecting from outside docker.
DATABASE_URL=postgresql+asyncpg://printcafe:printcafe@postgres:5432/printcafe

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
WAZZUP_INCOMING_STREAM=wazzup:incoming
WAZZUP_INCOMING_GROUP=dialog_workers
WAZZUP_INCOMING_CONSUMER=worker-1

# --- Qdrant (zarezervirovano dlya RAG, sledushiy etap) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# --- Wazzup24 ---
# API key from Wazzup24 personal account (Integrations -> API)
WAZZUP_API_KEY=
WAZZUP_API_BASE_URL=https://api.wazzup24.com
# Secret token used to verify incoming webhooks. Wazzup posts it as
# `Authorization: Bearer <crmKey>` (it equals the API key for personal API).
WAZZUP_WEBHOOK_SECRET=
# Public URL where Wazzup posts webhooks (used by scripts/subscribe_webhook.py)
WAZZUP_PUBLIC_WEBHOOK_URL=https://bot.example.com/webhooks/wazzup

# --- YandexGPT ---
# Yandex Cloud service account API key (role ai.languageModels.user)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Base URL of OpenAI-compatible AI Studio endpoint (since 2026-03)
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1
# Model URI. For YandexGPT 5.1 Pro use the /rc branch:
#   gpt://<folder_id>/yandexgpt/rc
# Replace <folder_id> with the actual folder id (or leave the placeholder
# and we substitute YANDEX_FOLDER_ID at runtime when value contains it).
YANDEX_MODEL=gpt://<folder_id>/yandexgpt/rc
YANDEX_TEMPERATURE=0.3
YANDEX_MAX_TOKENS=800
# Disable Yandex-side request logging (privacy)
YANDEX_DATA_LOGGING_ENABLED=false

# --- Dialog ---
DIALOG_HISTORY_WINDOW=20    # number of last messages kept in Redis short memory
DIALOG_HISTORY_TTL_SECONDS=604800   # 7 days
WAZZUP_DEDUP_TTL_SECONDS=86400      # 24 hours
WAZZUP_OUTGOING_SENT_TTL_SECONDS=3600  # 1 hour — echo of our own outgoing messageId
ENABLE_OPERATOR_TAKEOVER_FROM_ECHO=true  # set to false to ignore all outgoing echoes

# --- Whitelist for safe live testing ---
# Comma-separated chat IDs allowed to receive bot replies.
# Empty = bot replies to everyone (use only for dedicated test channel).
# Format: 79991234567 (no +, no spaces). Wazzup gives ids in this form.
WAZZUP_ALLOWED_CHAT_IDS=
